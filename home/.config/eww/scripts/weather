#!/usr/bin/python
"""Weather from configured coordinates using Open-Meteo; keep last successful result offline."""
import fcntl,json,math,os,subprocess,sys,time
from pathlib import Path
from datetime import datetime
from zoneinfo import ZoneInfo
from urllib.parse import urlencode
from settings import load_settings
settings = load_settings()["weather"]
LOCATION=settings['location']
TIMEZONE=settings['timezone']
URL='https://api.open-meteo.com/v1/forecast?' + urlencode({'latitude': settings['latitude'], 'longitude': settings['longitude'], 'current': 'temperature_2m,weather_code,is_day', 'timezone': settings['timezone']})
import hashlib
cache_key=hashlib.sha256(URL.encode()).hexdigest()[:16]
root=Path(os.environ.get('XDG_CACHE_HOME',str(Path.home()/'.cache')))/('eww/weather-' + cache_key)
root.mkdir(parents=True,exist_ok=True);cache=root/'current.json'

def condition(code,day):
    if code==0:return ('Trời quang','weather-clear-symbolic' if day else 'weather-clear-night-symbolic')
    if code in (1,2):return ('Ít mây' if code==1 else 'Có mây','weather-few-clouds-symbolic' if day else 'weather-few-clouds-night-symbolic')
    if code==3:return ('Nhiều mây','weather-overcast-symbolic')
    if code in (45,48):return ('Sương mù','weather-fog-symbolic')
    if code in (51,53,55,56,57):return ('Mưa phùn','weather-showers-scattered-symbolic')
    if code in (61,63,65,66,67):return ({61:'Mưa nhẹ',63:'Mưa vừa',65:'Mưa to'}.get(code,'Mưa lạnh'),'weather-showers-symbolic')
    if code in (71,73,75,77,85,86):return ('Tuyết rơi','weather-snow-symbolic')
    if code in (80,81,82):return ('Mưa rào','weather-showers-symbolic')
    if code in (95,96,99):return ('Mưa dông','weather-storm-symbolic')
    return ('Chưa rõ tình trạng','weather-overcast-symbolic')

def load():
    try:
        data=json.loads(cache.read_text());assert isinstance(data['fetched_at'],(int,float));return data
    except (OSError,ValueError,KeyError,AssertionError):return None

with (root/'fetch.lock').open('w') as lock:
    fcntl.flock(lock,fcntl.LOCK_EX)
    data=load()
    if '--refresh' in sys.argv or not data or time.time()-data['fetched_at']>=settings['refresh_seconds']:
        try:
            raw=subprocess.check_output(['curl','--fail','--silent','--show-error','--connect-timeout','5','--max-time','15',URL],stderr=subprocess.PIPE,timeout=18)
            current=json.loads(raw)['current'];temp=float(current['temperature_2m']);assert math.isfinite(temp)
            description,icon=condition(int(current['weather_code']),bool(current['is_day']))
            data={'location':LOCATION,'temp':f'{temp:.1f}'.replace('.',','),'description':description,'icon':icon,'observed_at':current['time'],'fetched_at':time.time()}
            tmp=root/'current.tmp';tmp.write_text(json.dumps(data,ensure_ascii=False));tmp.replace(cache)
        except (OSError,ValueError,KeyError,TypeError,AssertionError,subprocess.SubprocessError) as exc:
            print('Weather update failed: '+str(exc),file=sys.stderr)
    if data:
        value=dict(data)
        value["location"] = LOCATION
        stamp=datetime.fromtimestamp(data['fetched_at'],ZoneInfo(settings['timezone'])).strftime('%H:%M %d/%m')
        stale=' • Dữ liệu cũ, chưa thể cập nhật' if time.time()-data['fetched_at']>=settings['refresh_seconds'] * 2 else ''
        value['tooltip']=f'{LOCATION}\nCập nhật {stamp} ({TIMEZONE}){stale}\nDữ liệu: Open-Meteo · open-meteo.com'
    else:
        value={'location':LOCATION,'temp':'—','description':'Chưa có kết nối','icon':'weather-overcast-symbolic','tooltip':LOCATION+'\nChưa tải được dữ liệu từ Open-Meteo'}
output=json.dumps(value,ensure_ascii=False)
if '--push' in sys.argv:
    subprocess.run([str(Path.home()/'.local/bin/eww'),'update','weatherdata='+output],check=False,timeout=10)
else:print(output)
