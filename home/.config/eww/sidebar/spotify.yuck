(defwidget spotify []
  (box :class "genwin music-player" :orientation "h" :space-evenly false
       :tooltip {musicdata.tooltip}
    (box :class "music-content" :orientation "v" :space-evenly false :spacing 7 :hexpand true
      (label :class "music-source" :text {musicdata.source} :halign "start" :limit-width 24)
      (box :orientation "h" :space-evenly false :spacing 10
        (image :path {musicdata.art} :image-width 64 :image-height 64 :valign "center")
        (box :orientation "v" :space-evenly false :spacing 5 :valign "center"
          (label :class "music-title" :text {musicdata.title} :limit-width 18 :wrap true :halign "start" :xalign 0)
          (label :class "music-artist" :text {musicdata.artist} :limit-width 18 :halign "start" :xalign 0)))
      (label :class "music-status" :text {musicdata.status == "Playing" ? "Đang phát" : musicdata.status == "Paused" ? "Đã tạm dừng" : "Đã dừng"} :halign "start"))
    (box :class "song-controls" :orientation "v" :space-evenly true
      (button :tooltip "Bài tiếp theo" :timeout "3s" :onclick "@HOME@/.config/eww/scripts/media --action next"
        (image :icon "media-skip-forward-symbolic" :icon-size "large-toolbar"))
      (button :tooltip "Phát / Tạm dừng" :timeout "3s" :onclick "@HOME@/.config/eww/scripts/media --action play-pause"
        (image :icon {musicdata.play_icon} :icon-size "large-toolbar"))
      (button :tooltip "Bài trước" :timeout "3s" :onclick "@HOME@/.config/eww/scripts/media --action previous"
        (image :icon "media-skip-backward-symbolic" :icon-size "large-toolbar")))))
