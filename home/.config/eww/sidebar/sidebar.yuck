;; **** Structures *****************************************
(include "sidebar/struct/statusbox.yuck")
(include "sidebar/struct/quickaction.yuck")

;; **** Widgets ********************************************
(include "sidebar/profile.yuck")
(include "sidebar/weather.yuck")
(include "sidebar/spotify.yuck")

;; **** Sidebar ********************************************
(defwidget sidebar []

    (eventbox
        (box :class "container"
             :orientation "v"
             :space-evenly false

            (profile)
            (box :height 170
                 :width 340
                (weather)
                (box :orientation "v"
                    (statusbox :classes {homefree.css}
                              :icon_name "drive-harddisk-symbolic"
                              :header {homefree.value}
                              :description {homefree.description}
                              :tooltip "${homefree.tooltip} · Bấm để mở @HOME@"
                              :action "home")
                    (statusbox :classes {internetping.css}
                              :icon_name "network-transmit-receive-symbolic"
                              :header {internetping.value}
                              :description {internetping.description}
                              :tooltip "${internetping.tooltip} · Bấm để mở Network Manager"
                              :action "network")
                )
            )

            (box :class "quick-actions" :orientation "h" :space-evenly true :height 85
              (quickaction :icon "system-software-install-symbolic" :title "Store" :tooltip "Mở Software Manager" :action "store")
              (quickaction :icon "camera-photo-symbolic" :title "Chụp" :tooltip "Chụp vùng màn hình" :action "screenshot")
              (quickaction :icon "system-lock-screen-symbolic" :title "Khóa" :tooltip "Khóa màn hình" :action "lock")
              (quickaction :icon "system-shutdown-symbolic" :title "Thoát" :tooltip "Đăng xuất / Tắt máy" :action "logout")
            )

            (box :height 170 :visible {musicdata.active}
                 (spotify)
            )
        )
    )
)

;; **** Sidebar Window ************************************
(defwindow sidebar :stacking "fg"
                  :resizable false
                  :focusable false
                  :monitor "<primary>"
                  :geometry (geometry   :x 0
                                        :y -46
                                        :anchor "left bottom")
                    (sidebar)
)
