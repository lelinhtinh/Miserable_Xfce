(defwidget statusbox [?classes ?icon ?header ?description ?icon_name ?tooltip action]
    (button :class "statusbox-button"
            :onclick "@HOME@/.local/share/miserable-xfce/quick-action.sh ${action}"
    (box :class "genwin statusbox ${classes}"
         :tooltip {tooltip ?: ""}
         :space-evenly "true"
         :orientation "v"

        (box :orientation "h"
             :space-evenly "false"
             :valign "center"
             :halign "start"
             :spacing 12

            (box
              (image :visible {icon_name != ""} :icon {icon_name ?: "drive-harddisk-symbolic"} :icon-size "large-toolbar")
              (label :visible {icon_name == ""} :class "icon" :text {icon ?: ""})
            )
            (box :orientation "v"
                (label :text header
                       :halign "start"
                )
                (label :text description
                       :halign "start"
                       :limit-width 12
                )
            )
        )
    )
))
