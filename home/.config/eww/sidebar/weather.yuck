(defwidget weather []
  (box :class "genwin weather" :tooltip {weatherdata.tooltip}
       :orientation "v" :space-evenly false :spacing 3
    (box :orientation "h" :space-evenly false
      (label :text {weatherdata.location} :limit-width 18 :wrap true :halign "start" :hexpand true)
      (button :class "reload" :tooltip "Cập nhật thời tiết"
              :onclick "@HOME@/.config/eww/scripts/weather_reload"
        (image :icon "view-refresh-symbolic" :icon-size "menu")))
    (image :icon {weatherdata.icon} :icon-size "large-toolbar" :halign "start")
    (label :class "description" :text "${weatherdata.temp}°C" :halign "start")
    (label :class "title" :text {weatherdata.description} :halign "start" :wrap true)))
