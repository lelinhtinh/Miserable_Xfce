+/* A device choice must also move streams that PulseAudio has pinned to
+ * their previous sink. Own the name until the asynchronous list finishes. */
+static void
+pulseaudio_volume_move_playback_cb (pa_context *context,
+                                   const pa_sink_input_info *info,
+                                   int eol, void *userdata)
+{
+  gchar *name = userdata;
+  if (eol != 0)
+    {
+      g_free (name);
+      return;
+    }
+  if (info != NULL)
+    {
+      pa_operation *op = pa_context_move_sink_input_by_name (context, info->index, name, NULL, NULL);
+      if (op != NULL)
+        pa_operation_unref (op);
+    }
+}
+
+static void
+pulseaudio_volume_output_selected_cb (pa_context *context, int success, void *userdata)
+{
+  gchar *name = userdata;
+  pa_operation *op = NULL;
+  if (success)
+    op = pa_context_get_sink_input_info_list (context, pulseaudio_volume_move_playback_cb, name);
+  if (op != NULL)
+    pa_operation_unref (op);
+  else
+    g_free (name);
+}
