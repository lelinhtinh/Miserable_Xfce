diff --git a/panel-plugin/pulseaudio-menu.c b/panel-plugin/pulseaudio-menu.c
index abac8cd..1914e49 100644
--- a/panel-plugin/pulseaudio-menu.c
+++ b/panel-plugin/pulseaudio-menu.c
@@ -29,6 +29,7 @@
 #endif
 
 #include <glib.h>
+#include <xfconf/xfconf.h>
 #include <gtk/gtk.h>
 #include <libxfce4panel/libxfce4panel.h>
 #include <libxfce4util/libxfce4util.h>
@@ -85,9 +86,41 @@ pulseaudio_menu_class_init (PulseaudioMenuClass *klass)
 
 
 
+/* GtkMenu owns the keyboard while open, so Xfce cannot receive Print.
+ * Release the seat before starting the configured capture tool. */
+gboolean
+pulseaudio_menu_screenshot_key (GtkWidget *widget, GdkEventKey *event, gpointer userdata)
+{
+  gchar *command;
+  const gchar *property;
+  GError *error = NULL;
+  if (event->keyval != GDK_KEY_Print ||
+      (event->state & (GDK_CONTROL_MASK | GDK_SUPER_MASK | GDK_MOD4_MASK)))
+    return FALSE;
+  property = (event->state & GDK_MOD1_MASK) ? "/commands/custom/<Alt>Print" :
+             (event->state & GDK_SHIFT_MASK) ? "/commands/custom/<Shift>Print" :
+             "/commands/custom/Print";
+  command = xfconf_channel_get_string (xfconf_channel_get ("xfce4-keyboard-shortcuts"), property, NULL);
+  if (command == NULL || *command == '\0')
+    {
+      g_free (command);
+      return FALSE;
+    }
+  gdk_seat_ungrab (gdk_display_get_default_seat (gtk_widget_get_display (widget)));
+  gdk_display_flush (gtk_widget_get_display (widget));
+  if (!g_spawn_command_line_async (command, &error))
+    {
+      g_warning ("Screenshot failed: %s", error->message);
+      g_error_free (error);
+    }
+  g_free (command);
+  return TRUE;
+}
+
 static void
 pulseaudio_menu_init (PulseaudioMenu *menu)
 {
+  g_signal_connect (menu, "key-press-event", G_CALLBACK (pulseaudio_menu_screenshot_key), NULL);
 }
 
 
