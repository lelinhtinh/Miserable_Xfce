 #define ELAN_0C42 (1 << 2)
+#define ELAN_0C58 (1 << 3)
+
+/* area (press) sensors: a single frame covers enough of the finger, so
+ * frames are not stitched together (stitching corrupts the ridges) */
+#define ELAN_PRESS (1 << 4)
 
