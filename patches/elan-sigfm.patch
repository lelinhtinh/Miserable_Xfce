+#define ELAN_CALIBRATION_ATTEMPTS(dev_type) \
+  ((dev_type) == ELAN_0C58 ? 30 : ELAN_DEFAULT_CALIBRATION_ATTEMPTS)
 
 /* min and max frames in a capture */
 #define ELAN_MIN_FRAMES 7
 #define ELAN_MAX_FRAMES 30
 
+/* frames to read on press sensors before taking the last one, gives the
+ * finger time to settle on the sensor */
+#define ELAN_PRESS_FRAMES 12
+
+/* upscale factor for press sensor images, small images give NBIS too few
+ * minutiae */
+#define ELAN_PRESS_SCALE 2
+
 /* crop frames to this height to improve stitching */
 #define ELAN_MAX_FRAME_HEIGHT 50
 
